.vscode/**
.vscode-test/**
src/**
.gitignore
.yarnrc
vsc-extension-quickstart.md
**/tsconfig.json
**/.eslintrc.json
**/*.map
**/*.ts

# Build scripts (not needed in extension)
build-and-package.ps1
build-and-package.cmd
*.ps1
*.cmd
*.sh

# Development files
log.md
CLAUDE.md
architecture/**
handoffs/**
tools/**

# Scratch and generated artifacts — never ship
.tmp/**
mockups/**
tests/**
.git
mockup-*.html

# NOTE: do NOT add `!out/**` here. Nothing above excludes `out/`, so the negation
# is unnecessary — and because it runs after `**/*.map`, it re-included the source
# maps that rule had excluded. The compiled JS ships; the maps do not.
